{
  gateway: {
    mode: "local",
    bind: "loopback",
  },
  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
      model: "openai/gpt-5.6-sol",
      models: {
        "openai/gpt-5.6-sol": {
          agentRuntime: {
            id: "codex",
          },
        },
      },
    },
  },
  plugins: {
    entries: {
      codex: {
        enabled: true,
        config: {
          discovery: {
            enabled: true,
            timeoutMs: 2500,
          },
          appServer: {
            transport: "stdio",
            homeScope: "user",
            mode: "guardian",
            defaultWorkspaceDir: "~/.openclaw/workspace",
          },
        },
      },
      "ai-sdlc": {
        enabled: true,
        config: {
          postgresUrl: "${AI_SDLC_POSTGRES_URL}",
          qdrantUrl: "${AI_SDLC_QDRANT_URL}",
          qdrantApiKey: "${AI_SDLC_QDRANT_API_KEY}",
          knowledgeCollection: "${AI_SDLC_QDRANT_COLLECTION}",
          embeddingModel: "${AI_SDLC_QDRANT_EMBEDDING_MODEL}",
          embeddingDimension: "${AI_SDLC_QDRANT_EMBEDDING_DIMENSION}",
          qdrantDistance: "${AI_SDLC_QDRANT_DISTANCE}",
          openaiApiKey: "${AI_SDLC_OPENAI_API_KEY}",
        },
      },
    },
  },
}
