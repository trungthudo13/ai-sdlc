{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ai-sdlc.feature-design.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "featureId",
    "domain",
    "application",
    "ports",
    "acceptanceCriteria"
  ],
  "properties": {
    "schema": { "const": "ai-sdlc.feature-design.v1" },
    "featureId": { "type": "string", "minLength": 1 },
    "domain": {
      "type": "object",
      "required": ["aggregate", "behaviors"],
      "properties": {
        "aggregate": { "type": "string", "minLength": 1 },
        "behaviors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "application": {
      "type": "object",
      "required": ["input", "output", "handler"],
      "properties": {
        "input": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 },
        "handler": { "type": "string", "minLength": 1 }
      }
    },
    "ports": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "presentation": { "type": "object" },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
