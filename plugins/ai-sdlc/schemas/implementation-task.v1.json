{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ai-sdlc.implementation-task.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "featureId",
    "designArtifact",
    "baseRevision",
    "workspace",
    "writablePaths",
    "acceptanceCriteria"
  ],
  "properties": {
    "schema": { "const": "ai-sdlc.implementation-task.v1" },
    "featureId": { "type": "string", "minLength": 1 },
    "designArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "contentHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "baseRevision": { "type": "string", "minLength": 1 },
    "workspace": { "type": "string", "minLength": 1 },
    "writablePaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
