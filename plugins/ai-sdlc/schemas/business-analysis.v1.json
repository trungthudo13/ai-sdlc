{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ai-sdlc.business-analysis.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "featureId", "facts", "openDecisions", "acceptanceCriteria"],
  "properties": {
    "schema": { "const": "ai-sdlc.business-analysis.v1" },
    "featureId": { "type": "string", "minLength": 1 },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "openDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "risk", "blocking"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "risk": { "enum": ["low", "medium", "high", "critical"] },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
